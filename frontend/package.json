{
  "name": "@shelfsync/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ShelfSync's browser UI (React + TypeScript + Vite), served by the backend from frontend/dist.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "schema": "node scripts/schema.mjs",
    "schema:check": "node scripts/schema.mjs --check",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/sync-tokens.mjs --check && vite build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
